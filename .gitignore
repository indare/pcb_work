.history/
*-backups/
.history_trim/
.DS_STORE
*.lck
*.kicad_prl
*.bak
__pycache__/

# KiCad ERC/DRC reports (regenerate with kicad-cli)
*-erc.rpt
*-erc.json
*-drc.rpt
*-drc.json
DRC.rpt
*-bom.xml
Audio/split/AudioCase_for_separate.kicad_pcb

#vscode
.vscode/

# API 認証情報（DigiKey 等）。中身は絶対にコミットしない
.secrets.env

# Cursor MCP local overrides / setup backups (no personal paths in git)
.cursor/mcp.local.env
.cursor/mcp.json.*.kicad-mcp.bak

# Local build deps (MicroPython tree, ARM toolchain)
.deps/

# c_fft build outputs (rebuild: make test / ports/rp2 USER_C_MODULES)
Audio/measurement_fw/c_fft/test_host
Audio/measurement_fw/c_fft/test_host_san
Audio/measurement_fw/c_fft/*.dSYM/
Audio/measurement_fw/c_fft/*.uf2

# Claude and MCP specific files
# ローカル設定（settings.local.json 等）は無視する。ただし **共有するエージェント定義だけは
# 追跡する** —— `.cursor/rules/*.mdc` を追跡しているのと同じ理由で、査読の手順が
# 手元にしか無いと Cursor / Claude / 人間で食い違う（CLAUDE.md「Cursor と Claude で同じに動かすために」）
.claude/*
!.claude/agents/
!.claude/commands/
.mcp.json.*.kicad-mcp.bak
.mcp.json
# KiCad MCP / quality-gate generated outputs
Audio/output/
AudioV2/output/
AudioV2/.kicad-mcp/

# kicad-run.sh の出力 (ERC / DRC / ネットリスト)
/out/

# KiCad の autosave（開いている間だけ存在する一時ファイル）
_autosave-*

# エージェントが作る一時の作業ディレクトリ（PDF 抽出ヘルパ、取得した PDF、
# 引き直した検索結果など）。リポジトリの道具は AudioV2/scripts/ に置き、
# 残す価値のあるデータシートは AudioV2/datasheets/ へ手で移す
/.dsx/
/.work_indep/

# 計測の作業ファイル（2026-09-07）
# キャプチャの正は Audio/measurement_fw/captures/<日付>/ に置く。
# 直下の cap_*.txt は撮り直しの途中経過なので追跡しない。
Audio/measurement_fw/cap_*.txt
# 試験音は make_tone.py で再生成できる（rng シード固定で決定的）
Audio/measurement_fw/*.wav
