{
  "mcpServers": {
    "kicad": {
      "type": "stdio",
      "command": "uvx",
      "args": ["kicad-mcp-pro"],
      "env": {
        "KICAD_MCP_PROJECT_DIR": "${workspaceFolder}/<Audio または AudioV2>",
        "KICAD_MCP_PROFILE": "build",
        "KICAD_MCP_OPERATING_MODE": "write"
      }
    }
  }
}
