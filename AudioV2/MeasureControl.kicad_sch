	(title_block
		(title "計測モジュール - OPA1656 + ADC1804_F + Pico2 + LCD")
		(date "2026-08-20")
		(rev "0.4")
		(company "AudioCase project")
		(comment 1 "階層モジュール: アンバランス・ステレオ入力 → 差動 PCM1804 モジュール")
		(comment 2 "共立 ADC_1804_F マニュアル p.7 の基準インターフェースに基づく")
		(comment 3 "ASFL1 12.288MHz MCLK。ADCマスタ 48k/256fs。ジャンパ S/M=L, OSR2=L OSR1=H OSR0=H")
		(comment 4 "電源: ADC_VIN→MBC2596→LT1763×2(+3V3_A先行/+5V_A)。+5V_D=BP5293。D701 SOD-123 ショットキ +5V_D→VSYS。U708=XC8107 LCD、U709=TPS3307-33D（3.3V+5V 監視 SO-8）")
	)
