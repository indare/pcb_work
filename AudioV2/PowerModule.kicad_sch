	(text "AudioV2 PowerModule — simplified wired (§9 / CIRCUIT_DESIGN §4)\nUSB-C → 50224 CH224 → PD_12V/J_PD → (panel SW) → PD_12V_SW → F1 → DKMW20F-12\nPrimary PD_GND ≠ secondary A_GND. DKMW R.C. open=ON. LM7809 GND → A_GND.\n±12V + A_GND → J202 / hier.  LM7809 → VCC_TONE (+9V).  Bench +12V_IN: TBD."
		(at 25.4 20.32 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "50268717-437f-469f-8d2d-81eba8ab7f78")
