	(text "AudioV2 PowerModule — label-wired (§9 / CIRCUIT_DESIGN §4)\nUSB-C → CH224 → PD_12V/J_PD → (panel SW) → PD_12V_SW → F1 → DKMW_VIN\nPrimary PD_GND ≠ secondary A_GND. DKMW R.C.=RC_OPEN (open=ON). LM7809 GND→A_GND.\nConnectivity = local labels on pin tips (same name = same net)."
		(at 25.4 20.32 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "156acd7b-a1d5-4af9-a972-ea5c94072606")
