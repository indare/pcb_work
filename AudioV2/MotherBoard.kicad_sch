	(text "AudioV2 PowerModule — label-wired (§9 / CIRCUIT_DESIGN §4)\nJ_PD201←PD module; PD_12V → panel SW → PD_12V_SW → F1 → DKMW +Vin\nPrimary PD_GND ≠ secondary A_GND. DKMW R.C.=RC_OPEN (open=ON). LM7809 GND→A_GND.\nConnectivity = local labels on pin tips (same name = same net)."
		(exclude_from_sim no)
