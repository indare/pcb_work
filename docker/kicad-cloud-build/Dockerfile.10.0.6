# KiCad 10.0.6 CLI build environment (source build)
#
# Builds `kicad-cli` (and the pcbnew/eeschema plugins it needs) from the
# official KiCad 10.0.6 source tag, following the recipe published at
# https://gitlab.com/kicad/packaging/kicad-docker (Dockerfile.10.0-stable),
# adapted from Debian trixie to Ubuntu 24.04 so the build dependencies are
# available from Ubuntu's own archives.
#
# Why source build instead of `docker pull kicad/kicad:10.0.6`: at the time
# this was written, KiCad 10.0.6 had just been tagged upstream and the
# official Docker Hub image only went up to 10.0.5. Building from the
# 10.0.6 git tag guarantees an exact version match.
#
# Build:
#   docker build -f docker/kicad-cloud-build/Dockerfile.10.0.6 \
#     -t kicad-cloud:10.0.6 docker/kicad-cloud-build
#
# On a network that requires an HTTPS proxy (e.g. some CI sandboxes), pass
# --build-arg HTTPS_PROXY=http://<proxy-host>:<port> and, if that proxy
# terminates TLS with its own CA, add a `COPY` of that CA into
# /usr/local/share/ca-certificates/ before the `update-ca-certificates`
# step below.
#
# Run (example: DRC + Gerber export against a board in this repo):
#   docker run --rm \
#     -v "$PWD/Audio":/work:ro \
#     -v "$PWD/out":/out \
#     -w /work kicad-cloud:10.0.6 \
#     kicad-cli pcb drc --format json /work/split/AudioCase_4_amp.kicad_pcb -o /out/drc.json

FROM ubuntu:24.04 AS build
ARG KICAD_VERSION=10.0.6
ARG HTTPS_PROXY
ENV https_proxy=$HTTPS_PROXY
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get install -y build-essential cmake libbz2-dev libcairo2-dev libglu1-mesa-dev \
    libgl1-mesa-dev libglew-dev libx11-dev \
    libwxgtk3.2-dev \
    libwxgtk-webview3.2-dev \
    mesa-common-dev pkg-config python3-dev python3-wxgtk4.0 \
    libboost-all-dev libglm-dev libcurl4-openssl-dev \
    libgtk-3-dev \
    libngspice0-dev \
    ngspice \
    libocct-modeling-algorithms-dev \
    libocct-modeling-data-dev \
    libocct-data-exchange-dev \
    libocct-visualization-dev \
    libocct-foundation-dev \
    libocct-ocaf-dev \
    unixodbc-dev \
    zlib1g-dev \
    shared-mime-info \
    git \
    ca-certificates \
    gettext \
    ninja-build \
    libgit2-dev \
    libsecret-1-dev \
    libnng-dev \
    libprotobuf-dev \
    protobuf-compiler \
    swig \
    python3-pip \
    python3-venv \
    libzstd-dev \
    libspnav-dev \
    libpoppler-glib-dev

WORKDIR /src

RUN set -ex;            \
    git clone --depth=1 -b $KICAD_VERSION https://gitlab.com/kicad/code/kicad.git; \
    git clone --depth=1 -b $KICAD_VERSION https://gitlab.com/kicad/libraries/kicad-symbols.git; \
    git clone --depth=1 -b $KICAD_VERSION https://gitlab.com/kicad/libraries/kicad-footprints.git; \
    git clone --depth=1 -b $KICAD_VERSION https://gitlab.com/kicad/libraries/kicad-templates.git;

WORKDIR /src/kicad

RUN set -ex; \
    mkdir -p build/linux; \
    cd build/linux; \
    cmake \
      -G Ninja \
      -DCMAKE_BUILD_TYPE=Release \
      -DKICAD_SCRIPTING_WXPYTHON=ON \
      -DKICAD_USE_OCC=ON \
      -DKICAD_SPICE=ON \
      -DKICAD_BUILD_I18N=ON \
      -DCMAKE_INSTALL_PREFIX=/usr \
      -DKICAD_USE_CMAKE_FINDPROTOBUF=ON \
      ../../; \
    ninja; \
    cmake --install . --prefix=/usr/installtemp/

RUN set -ex; \
    cd /src/kicad-symbols; \
    cmake -G Ninja -DCMAKE_RULE_MESSAGES=OFF -DCMAKE_VERBOSE_MAKEFILE=OFF -DCMAKE_INSTALL_PREFIX=/usr .; \
    ninja; \
    cmake --install . --prefix=/usr/installtemp/

RUN set -ex; \
    cd /src/kicad-footprints; \
    cmake -G Ninja -DCMAKE_RULE_MESSAGES=OFF -DCMAKE_VERBOSE_MAKEFILE=OFF -DCMAKE_INSTALL_PREFIX=/usr .; \
    ninja; \
    cmake --install . --prefix=/usr/installtemp/

RUN set -ex; \
    cd /src/kicad-templates; \
    cmake -G Ninja -DCMAKE_RULE_MESSAGES=OFF -DCMAKE_VERBOSE_MAKEFILE=OFF -DCMAKE_INSTALL_PREFIX=/usr .; \
    ninja; \
    cmake --install . --prefix=/usr/installtemp/

FROM ubuntu:24.04 AS runtime
ARG USER_NAME=kicad
# 1000 is already used by the `ubuntu` user in the base image.
ARG USER_UID=1001
ARG USER_GID=$USER_UID
ENV DEBIAN_FRONTEND=noninteractive

LABEL org.opencontainers.image.description='KiCad 10.0.6 CLI (kicad-cli) build for pcb_work, for headless DRC / Gerber / drill export'

RUN apt-get update && \
    apt-get install -y libbz2-1.0 \
    libcairo2 \
    libglu1-mesa \
    libglew2.2 \
    libx11-6 \
    libwxbase3.2-1t64 \
    libwxgtk3.2-1t64 \
    libwxgtk-webview3.2-1t64 \
    libpython3.12 \
    python3 \
    python3-wxgtk4.0 \
    python3-yaml \
    libcurl4 \
    libngspice0 \
    ngspice \
    libocct-modeling-algorithms-7.6t64 \
    libocct-modeling-data-7.6t64 \
    libocct-data-exchange-7.6t64 \
    libocct-visualization-7.6t64 \
    libocct-foundation-7.6t64 \
    libocct-ocaf-7.6t64 \
    unixodbc \
    zlib1g \
    shared-mime-info \
    git \
    libgit2-1.7 \
    libsecret-1-0 \
    libprotobuf32t64 \
    libzstd1 \
    libnng1 \
    libspnav0 \
    libpoppler-glib8t64 \
    sudo

COPY --from=build /usr/installtemp/bin /usr/bin
COPY --from=build /usr/installtemp/share /usr/share
COPY --from=build /usr/installtemp/lib /usr/lib
COPY --from=build /usr/share/kicad /usr/share/kicad

RUN ldconfig -l /usr/bin/_pcbnew.kiface

RUN apt-get clean autoclean; \
    apt-get autoremove -y; \
    rm -rf /var/lib/apt/lists/*

ENV LANG=C.UTF-8
ENV LANGUAGE=C.UTF-8
ENV LC_ALL=C.UTF-8

RUN groupadd --gid $USER_GID $USER_NAME \
    && useradd --uid $USER_UID --gid $USER_GID -m $USER_NAME \
    && usermod -aG sudo $USER_NAME \
    && echo '%sudo ALL=(ALL) NOPASSWD:ALL' >> /etc/sudoers

RUN mkdir -p /home/$USER_NAME/.config/kicad/$(kicad-cli -v | cut -d . -f 1,2)
RUN cp /usr/share/kicad/template/*-lib-table /home/$USER_NAME/.config/kicad/$(kicad-cli -v | cut -d . -f 1,2)
RUN chown -R $USER_NAME:$USER_NAME /home/$USER_NAME/.config

USER $USER_NAME
